import random
from datasets import load_dataset

def print_random_samples(dataset, split="train_sft", n=5):
    """
    Print n random samples from the given split of the dataset.
    """
    ds = dataset[split]
    total = len(ds)
    print(f"Total examples in {split}: {total}")
    for _ in range(n):
        idx = random.randrange(total)
        example = ds[idx]
        # adjust based on what fields you want to print
        # e.g. prompt + completion
        prompt = example.get("prompt", "")
        completion = example.get("completion", "")
        messages = example.get("messages", None)
        print("=" * 40)
        print(f"Index: {idx}")
        if prompt or completion:
            print("Prompt:")
            print(prompt)
            print("Completion:")
            print(completion)
        elif messages:
            print("Messages:")
            for m in messages:
                role = m.get("role", "")
                content = m.get("content", "")
                print(f"  {role}: {content}")
        else:
            # fallback: print entire example
            print(example)
        print("=" * 40)
        print()

def main():
    # load the dataset
    dataset = load_dataset("HuggingFaceTB/everyday-conversations-llama3.1-2k")
    print_random_samples(dataset, split="train_sft", n=5)

if __name__ == "__main__":
    main()
